cmd_push_file() {
    # Accepts one or more relative paths.
    local rel errors=0
    local existing=() total_bytes=0

    for rel in "$@"; do
        local src="${LOCAL_ROOT}/${rel}"
        if [[ ! -f "$src" ]]; then
            log_error "local file not found: $(display_path "$src")"
            (( errors++ )) || true
            continue
        fi
        if ! path_is_within_root "$src" "$LOCAL_ROOT"; then
            log_error "refusing to push a path outside LOCAL_ROOT: ${rel}"
            (( errors++ )) || true
            continue
        fi
        existing+=("$rel")
        local sz
        sz="$(stat -c%s "$src" 2>/dev/null || echo 0)"
        total_bytes=$(( total_bytes + sz ))
    done

    if [[ ${#existing[@]} -gt 0 ]]; then
        confirm_if_large "${#existing[@]}" "$total_bytes" "This push" || return 1

        stats_begin
        for rel in "${existing[@]}"; do
            local src="${LOCAL_ROOT}/${rel}"
            local dest="${REMOTE_ROOT}/${rel}"
            mkdir -p "$(dirname "$dest")"
            echo "Push file: ${rel}"
            if ! stats_rsync -av "$src" "$dest"; then
                (( errors++ )) || true
            fi
        done
        stats_finish "push file"
    fi

    [[ $errors -eq 0 ]]
}

cmd_pull_file() {
    # Accepts one or more relative paths.
