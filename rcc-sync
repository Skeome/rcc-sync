# Mirror sub-menu: warn, confirm, snapshot, then execute.
dlg_mirror_menu() {
    local choice rc
    choice="$(dlg_menu "Mirror" "Choose a mirror direction:" \
        l2r  "Local → Remote  (remote becomes exact copy of local)" \
        r2l  "Remote → Local  (local becomes exact copy of remote)" \
        dl2r "Dry-run: Local → Remote preview" \
        dr2l "Dry-run: Remote → Local preview" \
        back "Back to main menu")"
    rc=$?
    [[ $rc -ne 0 || "$choice" == "back" ]] && return

    case "$choice" in
        dl2r)
            dlg_run_capture "Dry Mirror: Local → Remote" cmd_dry_mirror_local_to_remote
            return
            ;;
        dr2l)
            dlg_run_capture "Dry Mirror: Remote → Local" cmd_dry_mirror_remote_to_local
            return
            ;;
    esac

    # Destructive paths — build direction-specific strings.
    local src dest cmd_fn
    if [[ "$choice" == "l2r" ]]; then
        src="$(display_path "$LOCAL_ROOT")"
        dest="$(display_path "$REMOTE_ROOT")"
        cmd_fn="cmd_mirror_local_to_remote"
    else
        src="$(display_path "$REMOTE_ROOT")"
        dest="$(display_path "$LOCAL_ROOT")"
        cmd_fn="cmd_mirror_remote_to_local"
    fi

    # Explicit warning with yesno.
    "$DIALOG_BIN" --title "⚠  WARNING: DESTRUCTIVE OPERATION" --defaultno --yesno \
"Mirror: ${src}  →  ${dest}

This will make ${dest} an EXACT copy of ${src}.

Any file in ${dest} that does NOT exist in ${src}
WILL BE PERMANENTLY DELETED.

A compressed snapshot of ${dest} will be saved to:
  $(display_path "$ARCHIVE_DIR")
before the operation begins.

Are you absolutely sure you want to continue?" 18 72
    rc=$?
    [[ $rc -ne 0 ]] && return   # User chose No or pressed Esc.

    dlg_run_capture "Mirror ${src} → ${dest}" "$cmd_fn"
}

# Restore sub-menu: pick a snapshot, warn, confirm, then execute. Always
# passes an explicit snapshot name to cmd_restore so it never falls into
# its interactive picker (which would need a real terminal it won't have
# inside dlg_run_capture's background runner).
dlg_restore_menu() {
    if [[ ! -d "$ARCHIVE_DIR" ]]; then
        "$DIALOG_BIN" --title "Restore" --msgbox "Archive directory does not exist: $(display_path "$ARCHIVE_DIR")." 8 60
        return
    fi

    local snapshots=() f
    while IFS= read -r f; do
        snapshots+=("$f")
    done < <(find "$ARCHIVE_DIR" -maxdepth 1 -name 'rcc-sync-snapshot-*.tar.gz' 2>/dev/null | sort -r)

    if [[ ${#snapshots[@]} -eq 0 ]]; then
        "$DIALOG_BIN" --title "Restore" --msgbox "No snapshots found in $(display_path "$ARCHIVE_DIR")." 8 60
        return
    fi

    local items=() base
    for f in "${snapshots[@]}"; do
        base="$(basename "$f")"
        items+=("$base" "")
    done

    local choice rc
    choice="$(dlg_menu "Restore" "Choose a snapshot to restore:" "${items[@]}")"
    rc=$?
    [[ $rc -ne 0 ]] && return

    "$DIALOG_BIN" --title "⚠ Restore" --defaultno --yesno \
"Restoring '${choice}' will overwrite matching files in its original
location with the contents of this snapshot.

Files that already exist there but aren't in the snapshot are left
alone. A fresh snapshot of the current state is taken first.

Continue?" 14 70
    rc=$?
    [[ $rc -ne 0 ]] && return

    dlg_run_capture "Restore: ${choice}" cmd_restore "$choice"
}

