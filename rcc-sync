# ---------------------------------------------------------------------------
# Dependency check
# ---------------------------------------------------------------------------

check_deps() {
    local missing=()
    command -v rsync >/dev/null 2>&1 || missing+=("rsync")
    command -v diff  >/dev/null 2>&1 || missing+=("diffutils (diff)")
    command -v tar   >/dev/null 2>&1 || missing+=("tar")

    if [[ ${#missing[@]} -gt 0 ]]; then
        log_error "missing required tool(s): ${missing[*]}"
        echo "Install them with your distro's package manager and try again." >&2
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

main() {
    check_deps
    load_config
    apply_theme
    build_exclude_args

    # Parse global flags — these can appear anywhere on the command line
    # (before or after the subcommand), matching documented usage like
    # `rcc-sync push all --quiet`. `--` stops flag parsing, so a path
    # that happens to look like a flag can still be passed through.
    local args=() a seen_dashdash=0
    for a in "$@"; do
        if [[ $seen_dashdash -eq 1 ]]; then
            args+=("$a")
            continue
        fi
        case "$a" in
            --) seen_dashdash=1 ;;
            --verbose)  VERBOSE=1 ;;
            --quiet|-q) QUIET=1 ;;
            --yes|-y)   ASSUME_YES=1 ;;
            --json)     JSON_OUTPUT=1 ;;
            *)          args+=("$a") ;;
        esac
    done
    set -- "${args[@]}"

    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        help|-h|--help)
            cmd_help
            ;;
        version|-v|--version)
            cmd_version
            ;;
        --tui|-t)
            run_tui
            ;;
        status)
            if [[ $JSON_OUTPUT -eq 1 ]]; then
                cmd_status_json
            else
                cmd_status
            fi
            ;;
        diff)
            cmd_diff
            ;;
        config)
            case "${1:-}" in
                validate) cmd_config_validate ;;
                "")       cmd_config ;;
                *) echo "Usage: rcc-sync config [validate]" >&2; exit 1 ;;
            esac
            ;;
        init)
            cmd_init
            ;;
        restore)
            cmd_restore "${1:-}"
            ;;
        history)
            cmd_history "${1:-}"
            ;;
        push)
            case "${1:-}" in
                all)  cmd_push_all ;;
                file)
                    shift
                    [[ $# -gt 0 ]] || { echo "Usage: rcc-sync push file <path> [<path> ...]" >&2; exit 1; }
                    cmd_push_file "$@"
                    ;;
                dir)  [[ -n "${2:-}" ]] || { echo "Usage: rcc-sync push dir <path>" >&2; exit 1; }; cmd_push_dir "$2" ;;
                *) echo "Usage: rcc-sync push {all|file <path> [<path> ...]|dir <path>}" >&2; exit 1 ;;
            esac
            ;;
        pull)
            case "${1:-}" in
                all)  cmd_pull_all ;;
                file)
                    shift
                    [[ $# -gt 0 ]] || { echo "Usage: rcc-sync pull file <path> [<path> ...]" >&2; exit 1; }
                    cmd_pull_file "$@"
                    ;;
                dir)  [[ -n "${2:-}" ]] || { echo "Usage: rcc-sync pull dir <path>" >&2; exit 1; }; cmd_pull_dir "$2" ;;
                *) echo "Usage: rcc-sync pull {all|file <path> [<path> ...]|dir <path>}" >&2; exit 1 ;;
            esac
            ;;
        dry-push)
            case "${1:-}" in
                all) cmd_dry_push_all ;;
                *) echo "Usage: rcc-sync dry-push all" >&2; exit 1 ;;
            esac
            ;;
        dry-pull)
            case "${1:-}" in
                all) cmd_dry_pull_all ;;
                *) echo "Usage: rcc-sync dry-pull all" >&2; exit 1 ;;
            esac
            ;;
        mirror)
            case "${1:-}" in
                local)  cmd_mirror_local_to_remote ;;
                remote) cmd_mirror_remote_to_local ;;
                *) echo "Usage: rcc-sync mirror {local|remote}" >&2; exit 1 ;;
            esac
            ;;
        dry-mirror)
            case "${1:-}" in
                local)  cmd_dry_mirror_local_to_remote ;;
                remote) cmd_dry_mirror_remote_to_local ;;
                *) echo "Usage: rcc-sync dry-mirror {local|remote}" >&2; exit 1 ;;
            esac
            ;;
        *)
            echo "Unknown command: $cmd" >&2
            echo "Run 'rcc-sync help' for usage." >&2
            exit 1
            ;;
    esac
}

main "$@"
