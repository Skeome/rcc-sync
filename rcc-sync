# ---------------------------------------------------------------------------
# Commands: restore
# ---------------------------------------------------------------------------

cmd_restore() {
    local target="${1:-}"

    if [[ ! -d "$ARCHIVE_DIR" ]]; then
        log_error "Archive directory does not exist: $(display_path "$ARCHIVE_DIR")"
        return 1
    fi

    local snapshots=() f
    while IFS= read -r f; do
        snapshots+=("$f")
    done < <(find "$ARCHIVE_DIR" -maxdepth 1 -name 'rcc-sync-snapshot-*.tar.gz' 2>/dev/null | sort -r)

    if [[ ${#snapshots[@]} -eq 0 ]]; then
        log_error "No snapshots found in $(display_path "$ARCHIVE_DIR")."
        return 1
    fi

    local chosen=""

    if [[ -n "$target" ]]; then
        for f in "${snapshots[@]}"; do
            if [[ "$f" == "$target" || "$(basename "$f")" == "$target" || "$(basename "$f")" == *"$target"* ]]; then
                chosen="$f"
                break
            fi
        done
        if [[ -z "$chosen" ]]; then
            log_error "No snapshot matching '${target}' found in $(display_path "$ARCHIVE_DIR")."
            return 1
        fi
    else
        if [[ ! -t 0 ]]; then
            log_error "No snapshot named and no terminal to choose one interactively."
            echo "Run 'rcc-sync restore <name>' with an explicit snapshot name — see 'rcc-sync history' or list $(display_path "$ARCHIVE_DIR")." >&2
            return 1
        fi

        echo "Available snapshots (newest first):"
        echo
        local i=1
        for f in "${snapshots[@]}"; do
            printf '  %2d) %s\n' "$i" "$(basename "$f")"
            (( i++ )) || true
        done
        echo
        local sel
        read -r -p "Choose a snapshot to restore [1-${#snapshots[@]}]: " sel
        if ! [[ "$sel" =~ ^[0-9]+$ ]] || (( sel < 1 || sel > ${#snapshots[@]} )); then
            log_error "Invalid selection."
            return 1
        fi
        chosen="${snapshots[$((sel-1))]}"
    fi

    local base label dest
    base="$(basename "$chosen")"
    case "$base" in
        rcc-sync-snapshot-local-*)  label="local";  dest="$LOCAL_ROOT" ;;
        rcc-sync-snapshot-remote-*) label="remote"; dest="$REMOTE_ROOT" ;;
        *)
            log_error "Could not determine restore destination from snapshot name: $base"
            return 1
            ;;
    esac

    echo
    log_warn "This will overlay '${base}' onto $(display_path "$dest")."
    echo "Files in the snapshot overwrite matching files there; anything already"
    echo "in $(display_path "$dest") that isn't part of the snapshot is left alone."
    echo "A fresh snapshot of the current state is taken first, just in case."
    echo

    mkdir -p "$dest"
    make_snapshot "${label}-pre-restore" "$dest"
    echo

    local tmp_extract
    tmp_extract="$(mktemp -d)"
    if ! tar -xzf "$chosen" -C "$tmp_extract" 2>&1; then
        log_error "Failed to extract snapshot archive."
        rm -rf "$tmp_extract"
        return 1
    fi

    local extracted_dir
    extracted_dir="$(find "$tmp_extract" -mindepth 1 -maxdepth 1 -type d | head -n1)"
    if [[ -z "$extracted_dir" ]]; then
        log_error "Snapshot archive appears empty or malformed."
        rm -rf "$tmp_extract"
        return 1
    fi

    echo "Restoring $base -> $(display_path "$dest") ..."
    stats_begin
    stats_rsync -av "${extracted_dir}/" "${dest}/"
    local rc=$?
    stats_finish "restore: ${base}"
    rm -rf "$tmp_extract"
    return $rc
}

# ---------------------------------------------------------------------------
# Commands: history
# ---------------------------------------------------------------------------

cmd_history() {
    local arg="${1:-}"

    if [[ "$arg" == "clear" ]]; then
        if [[ -f "$HISTORY_FILE" ]]; then
            rm -f "$HISTORY_FILE"
            echo "History cleared."
        else
            echo "No sync history yet."
        fi
        return 0
    fi

    local limit="${arg:-20}"
    if ! [[ "$limit" =~ ^[0-9]+$ ]]; then
        log_error "Invalid history count: ${arg}"
        echo "Usage: rcc-sync history [N|clear]" >&2
        return 1
    fi

    if [[ ! -f "$HISTORY_FILE" ]]; then
        echo "No sync history yet."
        return 0
    fi

    echo "Sync history (most recent ${limit}):"
    echo
    tail -n "$limit" "$HISTORY_FILE" | tac | while IFS=$'\t' read -r ts label files bytes duration; do
        files="${files#files=}"
        bytes="${bytes#bytes=}"
        duration="${duration#duration=}"
        printf '  %s  %-22s  %s files, %8s, %s\n' \
            "$ts" "$label" "$files" "$(human_bytes "$bytes")" "$duration"
    done
}

# ---------------------------------------------------------------------------
# TUI (interactive mode) — rcc-sync --tui / -t
# ---------------------------------------------------------------------------

DIALOG_BIN=""

# Decide whether we can use whiptail/dialog: the binary must exist AND we
# need a real terminal on both stdin and stdout (ncurses needs a tty).
# If either condition fails, we transparently fall back to the plain
# numbered-menu TUI instead of crashing.
detect_tui_backend() {
    if [[ -t 0 && -t 1 ]]; then
        if command -v whiptail >/dev/null 2>&1; then
            DIALOG_BIN="whiptail"
        elif command -v dialog >/dev/null 2>&1; then
            DIALOG_BIN="dialog"
        fi
    fi
}

# --- dialog/whiptail widget wrappers ---------------------------------------

dlg_menu() {
    # $1 = title, $2 = prompt, rest = tag/description pairs
    local title="$1" prompt="$2"
    shift 2
    "$DIALOG_BIN" --title "$title" --menu "$prompt" 20 72 12 "$@" 3>&1 1>&2 2>&3
}

dlg_input() {
    # $1 = title, $2 = prompt, $3 = default
    "$DIALOG_BIN" --title "$1" --inputbox "$2" 10 72 "$3" 3>&1 1>&2 2>&3
}

dlg_show_file() {
    # $1 = title, $2 = file to display (scrollable)
    local title="$1" file="$2"
    local clean_file
    clean_file="$(mktemp)"
    
    # Strip ANSI escape sequences (e.g., \x1b[0;32m) for clean TUI textbox display.
    # Both dialog and whiptail textboxes do not interpret ANSI colors and will 
    # display them as literal garbage characters (like ^[[0;32m).
    # The $'...' syntax ensures bash expands \x1b to the actual ESC byte before passing to sed.
    sed $'s/\x1b\\[[0-9;]*[a-zA-Z]//g' "$file" > "$clean_file" 2>/dev/null || cat "$file" > "$clean_file"
    
    "$DIALOG_BIN" --title "$title" --textbox "$clean_file" 24 78
    rm -f "$clean_file"
}

# Run a command function (with optional args), capture its stdout+stderr,
# and show the result in a scrollable dialog box with a loading indicator.
dlg_run_capture() {
    local title="$1"
    shift
    local tmp
    tmp="$(mktemp)"
    {
        "$@" > "$tmp" 2>&1 &
        local bgpid=$!
        local pct=0
        while kill -0 "$bgpid" 2>/dev/null; do
            echo "$pct"
            pct=$(( (pct + 5) % 105 ))
            sleep 0.1
        done
        echo "100"
        wait "$bgpid"
    } | "$DIALOG_BIN" --title "Loading..." --gauge "Processing: ${title}\n\nPlease wait..." 8 65 0
    [[ -s "$tmp" ]] || echo "(no output)" > "$tmp"
    dlg_show_file "$title" "$tmp"
    rm -f "$tmp"
}

# Parse whiptail/dialog's checklist selection output: space-separated,
# individually double-quoted tags, e.g. "a.txt" "b/c.txt" — without eval.
parse_dialog_tags() {
    local remaining="$1"
    while [[ -n "$remaining" ]]; do
        if [[ "$remaining" =~ ^\"([^\"]*)\"[[:space:]]* ]]; then
            printf '%s\n' "${BASH_REMATCH[1]}"
            remaining="${remaining:${#BASH_REMATCH[0]}}"
        else
            break
        fi
    done
}

# Build a whiptail checklist of all files under a given root directory.
# Prints the selected relative paths, one per line. Returns 1 if cancelled
# or if no files exist.
dlg_file_checklist() {
    local root="$1" title="$2" prompt="$3"
    local items=() f rel
    while IFS= read -r f; do
        rel="${f#"${root}/"}"
        items+=("$rel" "" OFF)
    done < <(find "$root" -type f | sort)

    if [[ ${#items[@]} -eq 0 ]]; then
        "$DIALOG_BIN" --title "$title" --msgbox \
            "No files found in $(display_path "$root")." 8 55
        return 1
    fi

    local raw rc
    raw="$("$DIALOG_BIN" --title "$title" --checklist \
        "$prompt" 30 80 20 "${items[@]}" 3>&1 1>&2 2>&3)"
    rc=$?
    [[ $rc -ne 0 ]] && return 1
