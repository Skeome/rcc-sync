    parse_dialog_tags "$raw"
}

dlg_dir_radiolist() {
    local root="$1" title="$2" prompt="$3"
    local items=() d rel
    while IFS= read -r d; do
        rel="${d#"${root}/"}"
        items+=("$rel" "" OFF)
    done < <(find "$root" -mindepth 1 -type d | sort)

    if [[ ${#items[@]} -eq 0 ]]; then
        "$DIALOG_BIN" --title "$title" --msgbox \
            "No subdirectories found in $(display_path "$root")." 8 55
        return 1
    fi

    local raw rc
    raw="$("$DIALOG_BIN" --title "$title" --radiolist \
        "$prompt" 30 80 20 "${items[@]}" 3>&1 1>&2 2>&3)"
    rc=$?
    [[ $rc -ne 0 ]] && return 1
    [[ -z "$raw" ]] && return 1

    # Remove surrounding quotes
    raw="${raw%\"}"
    raw="${raw#\"}"
    printf '%s\n' "$raw"
}

