#!/usr/bin/env bash
#
# rcc-sync — explicit, non-destructive local <-> OneDrive sync workflow
# Built for Rogue Community College.
#
# rcc-sync never talks to the network itself. It assumes a separate
# OneDrive client (e.g. abraunegg's onedrive) is already keeping
# ~/OneDrive in sync with the cloud. This script only moves files between
# a local workspace and a local OneDrive-backed directory, using rsync.
#
# Version: 0.1

set -uo pipefail
# NOTE: intentionally not using `set -e`. Several commands used here
# (diff, rsync in some modes) have meaningful non-zero exit codes that
# do not mean "script failure", so we check exit codes explicitly instead.

VERSION="rcc-sync v0.1"

CONFIG_DIR="${HOME}/.config/rcc-sync"
CONFIG_FILE="${CONFIG_DIR}/config"

# Defaults — overridden by config file if present.
LOCAL_ROOT="${HOME}/College"
REMOTE_ROOT="${HOME}/OneDrive/College"
# Archive snapshots go here before every mirror. Keep outside OneDrive by
# default so they are never uploaded. Set to ~/OneDrive/RCC-Sync_Archives
# in config if you want cloud copies of your snapshots.
ARCHIVE_DIR="${HOME}/.rcc-sync-archives"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Expand a leading ~ (or ~/...) to $HOME. We do this ourselves because
# values come from a config file, not shell expansion.
expand_path() {
    local p="$1"
    case "$p" in
        "~") printf '%s' "${HOME}" ;;
        "~/"*) printf '%s' "${HOME}/${p#\~/}" ;;
        *) printf '%s' "$p" ;;
    esac
}

# Parse KEY=VALUE lines from the config file manually (never sourced).
# Ignores blank lines and lines starting with '#'. Only known keys are
# honored; unknown keys are ignored so a bad/foreign config can't do
# anything but be ignored.
load_config() {
    [[ -f "$CONFIG_FILE" ]] || return 0

    local line key value
    while IFS= read -r line || [[ -n "$line" ]]; do
        # Strip leading/trailing whitespace
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"

        [[ -z "$line" ]] && continue
        [[ "$line" == \#* ]] && continue
        [[ "$line" != *"="* ]] && continue

        key="${line%%=*}"
        value="${line#*=}"

        # Trim whitespace around key/value
        key="${key%"${key##*[![:space:]]}"}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"

        # Strip surrounding quotes if present
        if [[ "$value" == \"*\" || "$value" == \'*\' ]]; then
            value="${value:1:-1}"
        fi

        case "$key" in
            LOCAL_ROOT)   LOCAL_ROOT="$(expand_path "$value")" ;;
            REMOTE_ROOT)  REMOTE_ROOT="$(expand_path "$value")" ;;
            ARCHIVE_DIR)  ARCHIVE_DIR="$(expand_path "$value")" ;;
            *) : ;; # unknown key, ignore
        esac
    done < "$CONFIG_FILE"
}

# Print a path with $HOME collapsed back to ~ for display purposes.
display_path() {
    local p="$1"
    if [[ "$p" == "${HOME}"* ]]; then
        printf '~%s' "${p#"${HOME}"}"
    else
        printf '%s' "$p"
    fi
}

require_dir() {
    local dir="$1"
    local label="$2"
    if [[ ! -d "$dir" ]]; then
        echo "Error: $label directory does not exist: $dir" >&2
        return 1
    fi
    return 0
}

# ---------------------------------------------------------------------------
# Commands: help / version / config / init
# ---------------------------------------------------------------------------

cmd_help() {
    cat <<'EOF'
RCC Sync

USAGE

  rcc-sync COMMAND

COMMANDS

  help
      Show this help screen

  version
      Show version information

  status
      Show local/remote differences

  diff
      Show detailed differences (raw diff -rq output)

  push all
      Push local changes to remote

  pull all
      Pull remote changes to local

  dry-push all
      Preview push (no files modified)

  dry-pull all
      Preview pull (no files modified)

  push file <path> [<path> ...]
      Push one or more files. Accepts multiple space-separated paths or
      shell brace expansion: push file dir/{a.txt,b.txt}

  pull file <path> [<path> ...]
      Pull one or more files. Accepts multiple space-separated paths or
      shell brace expansion: pull file dir/{a.txt,b.txt}

  push dir <path>
      Push a single directory

  pull dir <path>
      Pull a single directory

  mirror local
      DESTRUCTIVE: make remote an exact copy of local (rsync --delete).
      Files in remote that are absent from local WILL BE DELETED.
      A compressed snapshot of remote is saved to ARCHIVE_DIR first.

  mirror remote
      DESTRUCTIVE: make local an exact copy of remote (rsync --delete).
      Files in local that are absent from remote WILL BE DELETED.
      A compressed snapshot of local is saved to ARCHIVE_DIR first.

  dry-mirror local
      Preview mirror local→remote without making any changes.

  dry-mirror remote
      Preview mirror remote→local without making any changes.

  init
      Interactive setup, writes ~/.config/rcc-sync/config

  config
      Show current LOCAL_ROOT / REMOTE_ROOT / ARCHIVE_DIR

  --tui, -t
      Launch interactive menu-driven mode. Uses whiptail/dialog if
      installed and a terminal is attached; otherwise falls back to a
      plain numbered menu.

NOTES

  push/pull never delete files. mirror does delete — use with care.
  A backup snapshot is always created before any mirror operation.
  Snapshots are stored in ARCHIVE_DIR (default: ~/.rcc-sync-archives).
  Set ARCHIVE_DIR=~/OneDrive/RCC-Sync_Archives in config to upload them.
  rcc-sync never runs in the background. It assumes your OneDrive client
  is already syncing ~/OneDrive with the cloud.
EOF
}

cmd_version() {
    echo "$VERSION"
}

cmd_config() {
    printf 'LOCAL_ROOT   = %s\n' "$(display_path "$LOCAL_ROOT")"
    printf 'REMOTE_ROOT  = %s\n' "$(display_path "$REMOTE_ROOT")"
    printf 'ARCHIVE_DIR  = %s\n' "$(display_path "$ARCHIVE_DIR")"
    if [[ -f "$CONFIG_FILE" ]]; then
        printf '\n(loaded from %s)\n' "$CONFIG_FILE"
    else
        printf '\n(no config file found, using defaults — run "rcc-sync init" to set one up)\n'
    fi
}

write_config() {
    mkdir -p "$CONFIG_DIR"
    {
        echo "# rcc-sync config"
        echo "LOCAL_ROOT=$(display_path "$LOCAL_ROOT")"
        echo "REMOTE_ROOT=$(display_path "$REMOTE_ROOT")"
        echo "ARCHIVE_DIR=$(display_path "$ARCHIVE_DIR")"
    } > "$CONFIG_FILE"
}

cmd_init() {
    echo "RCC Sync setup"
    echo

    local input_local input_remote input_archive
    read -r -p "Local College directory [$(display_path "$LOCAL_ROOT")]: " input_local
    read -r -p "OneDrive directory [$(display_path "$REMOTE_ROOT")]: " input_remote
    read -r -p "Archive/snapshot directory [$(display_path "$ARCHIVE_DIR")]: " input_archive

    [[ -n "$input_local" ]]   && LOCAL_ROOT="$(expand_path "$input_local")"
    [[ -n "$input_remote" ]]  && REMOTE_ROOT="$(expand_path "$input_remote")"
    [[ -n "$input_archive" ]] && ARCHIVE_DIR="$(expand_path "$input_archive")"

    write_config

    echo
    echo "Saved to $CONFIG_FILE"
    cmd_config
}

# ---------------------------------------------------------------------------
# Commands: status / diff
# ---------------------------------------------------------------------------

# Shared: run diff -rq between LOCAL_ROOT and REMOTE_ROOT.
# diff exits 0 (identical), 1 (differences found), or 2 (trouble) — none
# of those should be treated as a script failure.
run_diff_rq() {
    diff -rq "$LOCAL_ROOT" "$REMOTE_ROOT" 2>/dev/null
}

cmd_diff() {
    require_dir "$LOCAL_ROOT" "local" || return 1
    require_dir "$REMOTE_ROOT" "remote" || return 1

    local out
    out="$(run_diff_rq)"
    if [[ -z "$out" ]]; then
        echo "No differences."
    else
        printf '%s\n' "$out"
    fi
}

cmd_status() {
    require_dir "$LOCAL_ROOT" "local" || return 1
    require_dir "$REMOTE_ROOT" "remote" || return 1

    local local_only=() remote_only=() different=()
    local line

    while IFS= read -r line; do
        [[ -z "$line" ]] && continue

        if [[ "$line" == "Only in "* ]]; then
            # Format: "Only in <dir>: <name>"
            local rest dir name rel full
            rest="${line#Only in }"
            dir="${rest%%: *}"
            name="${rest#*: }"

            if [[ "$dir" == "$LOCAL_ROOT"* ]]; then
                rel="${dir#"$LOCAL_ROOT"}"
                rel="${rel#/}"
                [[ -n "$rel" ]] && name="${rel}/${name}"
                full="${LOCAL_ROOT}/${name}"
                if [[ -d "$full" ]]; then
                    while IFS= read -r f; do
                        local_only+=("${name}/${f#"${full}"/}")
                    done < <(find "$full" -type f)
                else
                    local_only+=("$name")
                fi
            elif [[ "$dir" == "$REMOTE_ROOT"* ]]; then
                rel="${dir#"$REMOTE_ROOT"}"
                rel="${rel#/}"
                [[ -n "$rel" ]] && name="${rel}/${name}"
                full="${REMOTE_ROOT}/${name}"
                if [[ -d "$full" ]]; then
                    while IFS= read -r f; do
                        remote_only+=("${name}/${f#"${full}"/}")
                    done < <(find "$full" -type f)
                else
                    remote_only+=("$name")
                fi
            fi

        elif [[ "$line" == "Files "* ]]; then
            # Format: "Files <a> and <b> differ"
            local rest a
            rest="${line#Files }"
            a="${rest%% and *}"
            if [[ "$a" == "$LOCAL_ROOT"* ]]; then
                local rel="${a#"$LOCAL_ROOT"}"
                rel="${rel#/}"
                different+=("$rel")
            fi
        fi
    done < <(run_diff_rq)

    if [[ ${#local_only[@]} -eq 0 && ${#remote_only[@]} -eq 0 && ${#different[@]} -eq 0 ]]; then
        echo "Up to date. No differences between local and remote."
        return 0
    fi

    if [[ ${#local_only[@]} -gt 0 ]]; then
        echo "LOCAL ONLY"
        echo
        for f in "${local_only[@]}"; do printf '  %s\n' "$f"; done
        echo
    fi

    if [[ ${#remote_only[@]} -gt 0 ]]; then
        echo "REMOTE ONLY"
        echo
        for f in "${remote_only[@]}"; do printf '  %s\n' "$f"; done
        echo
    fi

    if [[ ${#different[@]} -gt 0 ]]; then
        echo "DIFFERENT"
        echo
        for f in "${different[@]}"; do printf '  %s\n' "$f"; done
        echo
    fi
}

# ---------------------------------------------------------------------------
# Commands: push/pull all (V1), dry-push/dry-pull all (V1)
# ---------------------------------------------------------------------------

cmd_dry_push_all() {
    require_dir "$LOCAL_ROOT" "local" || return 1
    mkdir -p "$REMOTE_ROOT"
    echo "Preview: push ($(display_path "$LOCAL_ROOT") -> $(display_path "$REMOTE_ROOT"))"
    rsync -avn "${LOCAL_ROOT}/" "${REMOTE_ROOT}/"
}

cmd_push_all() {
    require_dir "$LOCAL_ROOT" "local" || return 1
    mkdir -p "$REMOTE_ROOT"
    echo "Push: $(display_path "$LOCAL_ROOT") -> $(display_path "$REMOTE_ROOT")"
    rsync -av "${LOCAL_ROOT}/" "${REMOTE_ROOT}/"
}

cmd_dry_pull_all() {
    require_dir "$REMOTE_ROOT" "remote" || return 1
    mkdir -p "$LOCAL_ROOT"
    echo "Preview: pull ($(display_path "$REMOTE_ROOT") -> $(display_path "$LOCAL_ROOT"))"
    rsync -avn "${REMOTE_ROOT}/" "${LOCAL_ROOT}/"
}

cmd_pull_all() {
    require_dir "$REMOTE_ROOT" "remote" || return 1
    mkdir -p "$LOCAL_ROOT"
    echo "Pull: $(display_path "$REMOTE_ROOT") -> $(display_path "$LOCAL_ROOT")"
    rsync -av "${REMOTE_ROOT}/" "${LOCAL_ROOT}/"
}

# ---------------------------------------------------------------------------
# Commands: push/pull file/dir (V2)
# ---------------------------------------------------------------------------

cmd_push_file() {
    # Accepts one or more relative paths.
    local rel errors=0
    for rel in "$@"; do
        local src="${LOCAL_ROOT}/${rel}"
        local dest="${REMOTE_ROOT}/${rel}"
        if [[ ! -f "$src" ]]; then
            echo "Error: local file not found: $(display_path "$src")" >&2
            (( errors++ )) || true
            continue
        fi
        mkdir -p "$(dirname "$dest")"
        echo "Push file: ${rel}"
        rsync -av "$src" "$dest"
    done
    [[ $errors -eq 0 ]]
}

cmd_pull_file() {
    # Accepts one or more relative paths.
    local rel errors=0
    for rel in "$@"; do
        local src="${REMOTE_ROOT}/${rel}"
        local dest="${LOCAL_ROOT}/${rel}"
        if [[ ! -f "$src" ]]; then
            echo "Error: remote file not found: $(display_path "$src")" >&2
            (( errors++ )) || true
            continue
        fi
        mkdir -p "$(dirname "$dest")"
        echo "Pull file: ${rel}"
        rsync -av "$src" "$dest"
    done
    [[ $errors -eq 0 ]]
}

cmd_push_dir() {
    local rel="$1"
    local src="${LOCAL_ROOT}/${rel}"
    local dest="${REMOTE_ROOT}/${rel}"

    if [[ ! -d "$src" ]]; then
        echo "Error: local directory not found: $(display_path "$src")" >&2
        return 1
    fi

    mkdir -p "$dest"
    echo "Push dir: ${rel}"
    rsync -av "${src}/" "${dest}/"
}

cmd_pull_dir() {
    local rel="$1"
    local src="${REMOTE_ROOT}/${rel}"
    local dest="${LOCAL_ROOT}/${rel}"

    if [[ ! -d "$src" ]]; then
        echo "Error: remote directory not found: $(display_path "$src")" >&2
        return 1
    fi

    mkdir -p "$dest"
    echo "Pull dir: ${rel}"
    rsync -av "${src}/" "${dest}/"
}

# ---------------------------------------------------------------------------
# Commands: mirror / dry-mirror
# ---------------------------------------------------------------------------

# Create a compressed tarball snapshot of a directory before mirroring.
make_snapshot() {
    local label="$1"   # descriptive name, e.g. "remote" or "local"
    local src_dir="$2" # directory to snapshot
    local ts
    ts="$(date +%Y%m%d-%H%M%S)"
    local archive="${ARCHIVE_DIR}/rcc-sync-snapshot-${label}-${ts}.tar.gz"
    mkdir -p "$ARCHIVE_DIR"
    echo "Creating snapshot: $(display_path "$archive")"
    tar -czf "$archive" -C "$(dirname "$src_dir")" "$(basename "$src_dir")" 2>&1
    echo "Snapshot saved."
}

cmd_dry_mirror_local_to_remote() {
    require_dir "$LOCAL_ROOT" "local" || return 1
    mkdir -p "$REMOTE_ROOT"
    echo "DRY-RUN mirror: $(display_path "$LOCAL_ROOT") → $(display_path "$REMOTE_ROOT") [--delete]"
    echo "Files shown below would be DELETED from remote or added/updated:"
    echo
    rsync -avn --delete "${LOCAL_ROOT}/" "${REMOTE_ROOT}/"
}

cmd_dry_mirror_remote_to_local() {
    require_dir "$REMOTE_ROOT" "remote" || return 1
    mkdir -p "$LOCAL_ROOT"
    echo "DRY-RUN mirror: $(display_path "$REMOTE_ROOT") → $(display_path "$LOCAL_ROOT") [--delete]"
    echo "Files shown below would be DELETED from local or added/updated:"
    echo
    rsync -avn --delete "${REMOTE_ROOT}/" "${LOCAL_ROOT}/"
}

cmd_mirror_local_to_remote() {
    require_dir "$LOCAL_ROOT" "local" || return 1
    mkdir -p "$REMOTE_ROOT"
    echo "Snapshotting remote before mirror..."
    make_snapshot "remote" "$REMOTE_ROOT"
    echo
    echo "Mirror: $(display_path "$LOCAL_ROOT") → $(display_path "$REMOTE_ROOT") [--delete]"
    rsync -av --delete "${LOCAL_ROOT}/" "${REMOTE_ROOT}/"
}

cmd_mirror_remote_to_local() {
    require_dir "$REMOTE_ROOT" "remote" || return 1
    mkdir -p "$LOCAL_ROOT"
    echo "Snapshotting local before mirror..."
    make_snapshot "local" "$LOCAL_ROOT"
    echo
    echo "Mirror: $(display_path "$REMOTE_ROOT") → $(display_path "$LOCAL_ROOT") [--delete]"
    rsync -av --delete "${REMOTE_ROOT}/" "${LOCAL_ROOT}/"
}

# ---------------------------------------------------------------------------
# TUI (interactive mode) — rcc-sync --tui / -t
# ---------------------------------------------------------------------------

DIALOG_BIN=""

# Decide whether we can use whiptail/dialog: the binary must exist AND we
# need a real terminal on both stdin and stdout (ncurses needs a tty).
# If either condition fails, we transparently fall back to the plain
# numbered-menu TUI instead of crashing.
detect_tui_backend() {
    if [[ -t 0 && -t 1 ]]; then
        if command -v whiptail >/dev/null 2>&1; then
            DIALOG_BIN="whiptail"
        elif command -v dialog >/dev/null 2>&1; then
            DIALOG_BIN="dialog"
        fi
    fi
}

# --- dialog/whiptail widget wrappers ---------------------------------------

dlg_menu() {
    # $1 = title, $2 = prompt, rest = tag/description pairs
    local title="$1" prompt="$2"
    shift 2
    "$DIALOG_BIN" --title "$title" --menu "$prompt" 20 72 12 "$@" 3>&1 1>&2 2>&3
}

dlg_input() {
    # $1 = title, $2 = prompt, $3 = default
    "$DIALOG_BIN" --title "$1" --inputbox "$2" 10 72 "$3" 3>&1 1>&2 2>&3
}

dlg_show_file() {
    # $1 = title, $2 = file to display (scrollable)
    "$DIALOG_BIN" --title "$1" --textbox "$2" 24 78
}

# Run a command function (with optional args), capture its stdout+stderr,
# and show the result in a scrollable dialog box with a loading indicator.
dlg_run_capture() {
    local title="$1"
    shift
    local tmp
    tmp="$(mktemp)"
    {
        "$@" > "$tmp" 2>&1 &
        local bgpid=$!
        local pct=0
        while kill -0 "$bgpid" 2>/dev/null; do
            echo "$pct"
            pct=$(( (pct + 5) % 105 ))
            sleep 0.1
        done
        echo "100"
        wait "$bgpid"
    } | "$DIALOG_BIN" --title "Loading..." --gauge "Processing: ${title}\n\nPlease wait..." 8 65 0
    [[ -s "$tmp" ]] || echo "(no output)" > "$tmp"
    dlg_show_file "$title" "$tmp"
    rm -f "$tmp"
}

# Build a whiptail checklist of all files under a given root directory.
# Prints the selected relative paths, one per line. Returns 1 if cancelled
# or if no files exist.
dlg_file_checklist() {
    local root="$1" title="$2" prompt="$3"
    local items=() f rel
    while IFS= read -r f; do
        rel="${f#"${root}/"}"
        items+=("$rel" "" OFF)
    done < <(find "$root" -type f | sort)

    if [[ ${#items[@]} -eq 0 ]]; then
        "$DIALOG_BIN" --title "$title" --msgbox \
            "No files found in $(display_path "$root")." 8 55
        return 1
    fi

    local raw rc
    raw="$("$DIALOG_BIN" --title "$title" --checklist \
        "$prompt" 30 80 20 "${items[@]}" 3>&1 1>&2 2>&3)"
    rc=$?
    [[ $rc -ne 0 ]] && return 1
    [[ -z "$raw" ]] && return 1

    # whiptail returns space-separated double-quoted tokens; split safely.
    local sel=() tok
    eval "sel=($raw)"
    for tok in "${sel[@]}"; do
        printf '%s\n' "$tok"
    done
}

dlg_push_menu() {
    local choice rc
    choice="$(dlg_menu "Push" "Push local -> remote:" \
        all  "Push everything" \
        file "Push files (select)" \
        dir  "Push a single directory" \
        back "Back to main menu")"
    rc=$?
    [[ $rc -ne 0 || "$choice" == "back" ]] && return

    case "$choice" in
        all)
            dlg_run_capture "Push All" cmd_push_all
            ;;
        file)
            local paths=() line
            while IFS= read -r line; do
                paths+=("$line")
            done < <(dlg_file_checklist "$LOCAL_ROOT" \
                "Push Files" \
                "Select files to push (SPACE toggles, ENTER confirms):")
            [[ ${#paths[@]} -gt 0 ]] && \
                dlg_run_capture "Push Files" cmd_push_file "${paths[@]}"
            ;;
        dir)
            local path
            path="$(dlg_input "Push Directory" "Relative path under $(display_path "$LOCAL_ROOT"):" "")"
            [[ $? -eq 0 && -n "$path" ]] && dlg_run_capture "Push Dir: $path" cmd_push_dir "$path"
            ;;
    esac
}

dlg_pull_menu() {
    local choice rc
    choice="$(dlg_menu "Pull" "Pull remote -> local:" \
        all  "Pull everything" \
        file "Pull files (select)" \
        dir  "Pull a single directory" \
        back "Back to main menu")"
    rc=$?
    [[ $rc -ne 0 || "$choice" == "back" ]] && return

    case "$choice" in
        all)
            dlg_run_capture "Pull All" cmd_pull_all
            ;;
        file)
            local paths=() line
            while IFS= read -r line; do
                paths+=("$line")
            done < <(dlg_file_checklist "$REMOTE_ROOT" \
                "Pull Files" \
                "Select files to pull (SPACE toggles, ENTER confirms):")
            [[ ${#paths[@]} -gt 0 ]] && \
                dlg_run_capture "Pull Files" cmd_pull_file "${paths[@]}"
            ;;
        dir)
            local path
            path="$(dlg_input "Pull Directory" "Relative path under $(display_path "$REMOTE_ROOT"):" "")"
            [[ $? -eq 0 && -n "$path" ]] && dlg_run_capture "Pull Dir: $path" cmd_pull_dir "$path"
            ;;
    esac
}

dlg_init_menu() {
    local new_local new_remote new_archive rc
    new_local="$(dlg_input "Setup — Local" "Local College directory:" "$(display_path "$LOCAL_ROOT")")"
    rc=$?
    [[ $rc -ne 0 ]] && return
    new_remote="$(dlg_input "Setup — Remote" "OneDrive directory:" "$(display_path "$REMOTE_ROOT")")"
    rc=$?
    [[ $rc -ne 0 ]] && return
    new_archive="$(dlg_input "Setup — Archives" \
        "Snapshot directory (set to ~/OneDrive/RCC-Sync_Archives for cloud backup):" \
        "$(display_path "$ARCHIVE_DIR")")"
    rc=$?
    [[ $rc -ne 0 ]] && return

    [[ -n "$new_local" ]]   && LOCAL_ROOT="$(expand_path "$new_local")"
    [[ -n "$new_remote" ]]  && REMOTE_ROOT="$(expand_path "$new_remote")"
    [[ -n "$new_archive" ]] && ARCHIVE_DIR="$(expand_path "$new_archive")"
    write_config
    dlg_run_capture "Config Saved" cmd_config
}

# Mirror sub-menu: warn, confirm, snapshot, then execute.
dlg_mirror_menu() {
    local choice rc
    choice="$(dlg_menu "Mirror" "Choose a mirror direction:" \
        l2r  "Local → Remote  (remote becomes exact copy of local)" \
        r2l  "Remote → Local  (local becomes exact copy of remote)" \
        dl2r "Dry-run: Local → Remote preview" \
        dr2l "Dry-run: Remote → Local preview" \
        back "Back to main menu")"
    rc=$?
    [[ $rc -ne 0 || "$choice" == "back" ]] && return

    case "$choice" in
        dl2r)
            dlg_run_capture "Dry Mirror: Local → Remote" cmd_dry_mirror_local_to_remote
            return
            ;;
        dr2l)
            dlg_run_capture "Dry Mirror: Remote → Local" cmd_dry_mirror_remote_to_local
            return
            ;;
    esac

    # Destructive paths — build direction-specific strings.
    local src dest cmd_fn
    if [[ "$choice" == "l2r" ]]; then
        src="$(display_path "$LOCAL_ROOT")"
        dest="$(display_path "$REMOTE_ROOT")"
        cmd_fn="cmd_mirror_local_to_remote"
    else
        src="$(display_path "$REMOTE_ROOT")"
        dest="$(display_path "$LOCAL_ROOT")"
        cmd_fn="cmd_mirror_remote_to_local"
    fi

    # Explicit warning with yesno.
    "$DIALOG_BIN" --title "⚠  WARNING: DESTRUCTIVE OPERATION" --defaultno --yesno \
"Mirror: ${src}  →  ${dest}

This will make ${dest} an EXACT copy of ${src}.

Any file in ${dest} that does NOT exist in ${src}
WILL BE PERMANENTLY DELETED.

A compressed snapshot of ${dest} will be saved to:
  $(display_path "$ARCHIVE_DIR")
before the operation begins.

Are you absolutely sure you want to continue?" 18 72
    rc=$?
    [[ $rc -ne 0 ]] && return   # User chose No or pressed Esc.

    dlg_run_capture "Mirror ${src} → ${dest}" "$cmd_fn"
}

run_tui_dialog() {
    local choice rc
    while true; do
        choice="$(dlg_menu "RCC Sync ${VERSION#rcc-sync }" "Choose an action:" \
            status   "Show status" \
            diffcmd  "Show detailed diff" \
            push     "Push (local → remote)" \
            pull     "Pull (remote → local)" \
            mirror   "⚠  Mirror — destructive exact sync" \
            drypush  "Preview push (dry-run)" \
            drypull  "Preview pull (dry-run)" \
            config   "Show current config" \
            init     "Setup / change config" \
            quit     "Quit")"
        rc=$?
        [[ $rc -ne 0 ]] && break   # ESC / Cancel

        case "$choice" in
            status)  dlg_run_capture "Status" cmd_status ;;
            diffcmd) dlg_run_capture "Diff" cmd_diff ;;
            push)    dlg_push_menu ;;
            pull)    dlg_pull_menu ;;
            mirror)  dlg_mirror_menu ;;
            drypush) dlg_run_capture "Dry Push Preview" cmd_dry_push_all ;;
            drypull) dlg_run_capture "Dry Pull Preview" cmd_dry_pull_all ;;
            config)  dlg_run_capture "Config" cmd_config ;;
            init)    dlg_init_menu ;;
            quit)    break ;;
        esac
    done
    clear 2>/dev/null || true
}

# --- plain fallback TUI (no whiptail/dialog, or no tty) --------------------

plain_pause() {
    echo
    read -r -p "Press Enter to continue..." _ || true
}

plain_push_menu() {
    echo
    echo "  1) Push all"
    echo "  2) Push file"
    echo "  3) Push dir"
    echo "  4) Back"
    local c
    read -r -p "Choose an option [1-4]: " c
    case "$c" in
        1) cmd_push_all; plain_pause ;;
        2)
            local p
            read -r -p "Relative path to file (under $(display_path "$LOCAL_ROOT")): " p
            [[ -n "$p" ]] && cmd_push_file "$p"
            plain_pause
            ;;
        3)
            local p
            read -r -p "Relative path to dir (under $(display_path "$LOCAL_ROOT")): " p
            [[ -n "$p" ]] && cmd_push_dir "$p"
            plain_pause
            ;;
        *) : ;;
    esac
}

plain_pull_menu() {
    echo
    echo "  1) Pull all"
    echo "  2) Pull file"
    echo "  3) Pull dir"
    echo "  4) Back"
    local c
    read -r -p "Choose an option [1-4]: " c
    case "$c" in
        1) cmd_pull_all; plain_pause ;;
        2)
            local p
            read -r -p "Relative path to file (under $(display_path "$REMOTE_ROOT")): " p
            [[ -n "$p" ]] && cmd_pull_file "$p"
            plain_pause
            ;;
        3)
            local p
            read -r -p "Relative path to dir (under $(display_path "$REMOTE_ROOT")): " p
            [[ -n "$p" ]] && cmd_pull_dir "$p"
            plain_pause
            ;;
        *) : ;;
    esac
}

plain_mirror_menu() {
    echo
    echo "  Mirror — DESTRUCTIVE (uses rsync --delete)"
    echo
    echo "  1) Mirror local → remote  (remote becomes exact copy of local)"
    echo "  2) Mirror remote → local  (local becomes exact copy of remote)"
    echo "  3) Dry-run: local → remote preview"
    echo "  4) Dry-run: remote → local preview"
    echo "  5) Back"
    local c
    read -r -p "Choose an option [1-5]: " c
    case "$c" in
        1)
            echo
            echo "WARNING: This will DELETE files in remote that are not in local."
            echo "A snapshot of remote will be saved to $(display_path "$ARCHIVE_DIR") first."
            read -r -p "Type YES to confirm: " confirm
            [[ "$confirm" == "YES" ]] && cmd_mirror_local_to_remote
            plain_pause
            ;;
        2)
            echo
            echo "WARNING: This will DELETE files in local that are not in remote."
            echo "A snapshot of local will be saved to $(display_path "$ARCHIVE_DIR") first."
            read -r -p "Type YES to confirm: " confirm
            [[ "$confirm" == "YES" ]] && cmd_mirror_remote_to_local
            plain_pause
            ;;
        3) cmd_dry_mirror_local_to_remote; plain_pause ;;
        4) cmd_dry_mirror_remote_to_local; plain_pause ;;
        *) : ;;
    esac
}

run_tui_plain() {
    local choice
    while true; do
        echo
        echo "RCC Sync — Interactive Mode (${VERSION#rcc-sync })"
        echo
        echo "  1) Status"
        echo "  2) Diff"
        echo "  3) Push"
        echo "  4) Pull"
        echo "  5) Mirror  [DESTRUCTIVE]"
        echo "  6) Dry Push (preview)"
        echo "  7) Dry Pull (preview)"
        echo "  8) Config"
        echo "  9) Init / Setup"
        echo " 10) Quit"
        echo

        if ! read -r -p "Choose an option [1-10]: " choice; then
            break   # stdin closed (EOF) — exit cleanly
        fi

        case "$choice" in
            1) cmd_status; plain_pause ;;
            2) cmd_diff; plain_pause ;;
            3) plain_push_menu ;;
            4) plain_pull_menu ;;
            5) plain_mirror_menu ;;
            6) cmd_dry_push_all; plain_pause ;;
            7) cmd_dry_pull_all; plain_pause ;;
            8) cmd_config; plain_pause ;;
            9) cmd_init; plain_pause ;;
           10) break ;;
            "") : ;;
            *) echo "Invalid option: $choice"; plain_pause ;;
        esac
    done
}

run_tui() {
    detect_tui_backend
    if [[ -n "$DIALOG_BIN" ]]; then
        run_tui_dialog
    else
        run_tui_plain
    fi
}

# ---------------------------------------------------------------------------
# Dependency check
# ---------------------------------------------------------------------------

check_deps() {
    local missing=()
    command -v rsync >/dev/null 2>&1 || missing+=("rsync")
    command -v diff  >/dev/null 2>&1 || missing+=("diffutils (diff)")

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "Error: missing required tool(s): ${missing[*]}" >&2
        echo "Install them with your distro's package manager and try again." >&2
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

main() {
    check_deps
    load_config

    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        help|-h|--help)
            cmd_help
            ;;
        version|-v|--version)
            cmd_version
            ;;
        --tui|-t)
            run_tui
            ;;
        status)
            cmd_status
            ;;
        diff)
            cmd_diff
            ;;
        config)
            cmd_config
            ;;
        init)
            cmd_init
            ;;
        push)
            case "${1:-}" in
                all)  cmd_push_all ;;
                file)
                    shift
                    [[ $# -gt 0 ]] || { echo "Usage: rcc-sync push file <path> [<path> ...]" >&2; exit 1; }
                    cmd_push_file "$@"
                    ;;
                dir)  [[ -n "${2:-}" ]] || { echo "Usage: rcc-sync push dir <path>" >&2; exit 1; }; cmd_push_dir "$2" ;;
                *) echo "Usage: rcc-sync push {all|file <path> [<path> ...]|dir <path>}" >&2; exit 1 ;;
            esac
            ;;
        pull)
            case "${1:-}" in
                all)  cmd_pull_all ;;
                file)
                    shift
                    [[ $# -gt 0 ]] || { echo "Usage: rcc-sync pull file <path> [<path> ...]" >&2; exit 1; }
                    cmd_pull_file "$@"
                    ;;
                dir)  [[ -n "${2:-}" ]] || { echo "Usage: rcc-sync pull dir <path>" >&2; exit 1; }; cmd_pull_dir "$2" ;;
                *) echo "Usage: rcc-sync pull {all|file <path> [<path> ...]|dir <path>}" >&2; exit 1 ;;
            esac
            ;;
        dry-push)
            case "${1:-}" in
                all) cmd_dry_push_all ;;
                *) echo "Usage: rcc-sync dry-push all" >&2; exit 1 ;;
            esac
            ;;
        dry-pull)
            case "${1:-}" in
                all) cmd_dry_pull_all ;;
                *) echo "Usage: rcc-sync dry-pull all" >&2; exit 1 ;;
            esac
            ;;
        mirror)
            case "${1:-}" in
                local)  cmd_mirror_local_to_remote ;;
                remote) cmd_mirror_remote_to_local ;;
                *) echo "Usage: rcc-sync mirror {local|remote}" >&2; exit 1 ;;
            esac
            ;;
        dry-mirror)
            case "${1:-}" in
                local)  cmd_dry_mirror_local_to_remote ;;
                remote) cmd_dry_mirror_remote_to_local ;;
                *) echo "Usage: rcc-sync dry-mirror {local|remote}" >&2; exit 1 ;;
            esac
            ;;
        *)
            echo "Unknown command: $cmd" >&2
            echo "Run 'rcc-sync help' for usage." >&2
            exit 1
            ;;
    esac
}

main "$@"
