#!/usr/bin/env bash
#
# rcc-sync — explicit, non-destructive local <-> Cloud sync workflow
# Built for Rogue Community College.
#
# rcc-sync never talks to the network itself. It assumes a separate
# cloud client (e.g. abraunegg's onedrive) is already keeping
# ~/OneDrive (for example) in sync with the cloud. This script only moves files between
# a local workspace and a local destination directory, using rsync.
#
# Version: 1.2.1
#
# New in 1.2.1: four new high-contrast TUI color themes (nord, dracula,
# solarized, gruvbox), custom Whiptail colors (CUSTOM_NEWT_COLORS) and
# custom plaintext ANSI colors (CUSTOM_ANSI_COLORS) via config, and
# enhanced ANSI-styled plaintext TUI fallback menus.
#
# New in 1.2.0: config validation, snapshot restore, a sync history log,
# transfer statistics, JSON status output, include/exclude patterns, and
# a confirmation prompt before unusually large push/pull/mirror runs.
# Also: push/pull file & dir now refuse paths that resolve (via "../" or
# a symlink) outside LOCAL_ROOT/REMOTE_ROOT, and the TUI checklist/search
# parsing no longer uses eval.

set -uo pipefail
# NOTE: intentionally not using `set -e`. Several commands used here
# (diff, rsync in some modes) have meaningful non-zero exit codes that
# do not mean "script failure", so we check exit codes explicitly instead.

VERSION="rcc-sync v1.2.1"

VERBOSE=0
QUIET=0
ASSUME_YES=0
JSON_OUTPUT=0

# ANSI Colors
C_RESET='\033[0m'
C_BOLD='\033[1m'
C_DIM='\033[2m'
C_RED='\033[0;31m'
C_GREEN='\033[0;32m'
C_YELLOW='\033[0;33m'
C_BLUE='\033[0;34m'
C_MAGENTA='\033[0;35m'
C_CYAN='\033[0;36m'

C_PRIMARY="${C_CYAN}"
C_ACCENT="${C_BLUE}"

log_error() {
    echo -e "${C_RED}${C_BOLD}Error:${C_RESET} $*" >&2
}

log_warn() {
    echo -e "${C_YELLOW}${C_BOLD}WARNING:${C_RESET} $*" >&2
}

CONFIG_DIR="${HOME}/.config/rcc-sync"
CONFIG_FILE="${CONFIG_DIR}/config"
HISTORY_FILE="${CONFIG_DIR}/history.log"

# Defaults — overridden by config file if present.
LOCAL_ROOT="${HOME}/College"
REMOTE_ROOT="${HOME}/OneDrive/College"
# Archive snapshots go here before every mirror. Keep outside OneDrive by
# default so they are never uploaded. Set to ~/OneDrive/RCC-Sync_Archives
# in config if you want cloud copies of your snapshots.
ARCHIVE_DIR="${HOME}/.rcc-sync-archives"

# TUI color theme
TUI_THEME="default"
CUSTOM_NEWT_COLORS=""
CUSTOM_ANSI_COLORS=""

# Optional include/exclude support — see build_exclude_args. Empty by
# default, meaning nothing is excluded unless configured.
EXCLUDE_FILE=""
EXCLUDE_PATTERNS=""

# "Large transfer" confirmation thresholds for push/pull/mirror — prompt
# before transferring at least this many files or this much data. Set
# either to 0 to disable that particular check. Bypassed by --yes/-y,
# --quiet, or automatically when there's no terminal to prompt on (e.g.
# when a command is run from inside the dialog-based TUI).
CONFIRM_FILE_THRESHOLD=100
CONFIRM_SIZE_THRESHOLD_MB=500

# Populated from EXCLUDE_FILE / EXCLUDE_PATTERNS by build_exclude_args.
EXCLUDE_ARGS=()

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Expand a leading ~ (or ~/...) to $HOME. We do this ourselves because
# values come from a config file, not shell expansion.
expand_path() {
    local p="$1"
    # shellcheck disable=SC2088  # "~/"* below is an intentional literal match, not expansion
    case "$p" in
        "~") printf '%s' "${HOME}" ;;
        "~/"*) printf '%s' "${HOME}/${p#\~/}" ;;
        *) printf '%s' "$p" ;;
    esac
}

# Parse KEY=VALUE lines from the config file manually (never sourced).
# Ignores blank lines and lines starting with '#'. Only known keys are
# honored; unknown keys are ignored so a bad/foreign config can't do
# anything but be ignored.
load_config() {
    [[ -f "$CONFIG_FILE" ]] || return 0

    local line key value
    while IFS= read -r line || [[ -n "$line" ]]; do
        # Strip leading/trailing whitespace
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"

        [[ -z "$line" ]] && continue
        [[ "$line" == \#* ]] && continue
        [[ "$line" != *"="* ]] && continue

        key="${line%%=*}"
        value="${line#*=}"

        # Trim whitespace around key/value
        key="${key%"${key##*[![:space:]]}"}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"

        # Strip surrounding quotes if present
        if [[ "$value" == \"*\" || "$value" == \'*\' ]]; then
            value="${value:1:-1}"
        fi

        case "$key" in
            LOCAL_ROOT)   LOCAL_ROOT="$(expand_path "$value")" ;;
            REMOTE_ROOT)  REMOTE_ROOT="$(expand_path "$value")" ;;
            ARCHIVE_DIR)  ARCHIVE_DIR="$(expand_path "$value")" ;;
            TUI_THEME)    TUI_THEME="$value" ;;
            CUSTOM_NEWT_COLORS) CUSTOM_NEWT_COLORS="$value" ;;
            CUSTOM_ANSI_COLORS) CUSTOM_ANSI_COLORS="$value" ;;
            EXCLUDE_FILE) EXCLUDE_FILE="$(expand_path "$value")" ;;
            EXCLUDE_PATTERNS) EXCLUDE_PATTERNS="$value" ;;
            CONFIRM_FILE_THRESHOLD)
                [[ "$value" =~ ^[0-9]+$ ]] && CONFIRM_FILE_THRESHOLD="$value"
                ;;
            CONFIRM_SIZE_THRESHOLD_MB)
                [[ "$value" =~ ^[0-9]+$ ]] && CONFIRM_SIZE_THRESHOLD_MB="$value"
                ;;
            *) : ;; # unknown key, ignore
        esac
    done < "$CONFIG_FILE"
}

# Print a path with $HOME collapsed back to ~ for display purposes.
display_path() {
    local p="$1"
    if [[ "$p" == "${HOME}"* ]]; then
        printf '~%s' "${p#"${HOME}"}"
    else
        printf '%s' "$p"
    fi
}

require_dir() {
    local dir="$1"
    local label="$2"
    if [[ ! -d "$dir" ]]; then
        log_error "$label directory does not exist: $(display_path "$dir")"
        return 1
    fi
    return 0
}

# Resolve $path (a file or directory that must already exist) to an
# absolute, symlink-resolved location and confirm it is $root itself or
# somewhere underneath it. Used to stop push/pull file & dir arguments
# from resolving — via "../" or a symlink — to somewhere outside the
# configured root. Note: this deliberately does NOT try to `cd` into a
# plain file (you can't); files are resolved via their parent directory.
path_is_within_root() {
    local path="$1" root="$2"
    local abs_root abs_path

    abs_root="$(cd "$root" 2>/dev/null && pwd -P)" || return 1

    if [[ -d "$path" ]]; then
        abs_path="$(cd "$path" 2>/dev/null && pwd -P)" || return 1
    else
        local parent base abs_parent
        parent="$(dirname "$path")"
        base="$(basename "$path")"
        abs_parent="$(cd "$parent" 2>/dev/null && pwd -P)" || return 1
        abs_path="${abs_parent}/${base}"
    fi

    [[ "$abs_path" == "$abs_root" || "$abs_path" == "${abs_root}/"* ]]
}

# ---------------------------------------------------------------------------
# Transfer statistics, history log, excludes, and large-transfer confirmation
# ---------------------------------------------------------------------------

# Format a byte count as a short human-readable size.
human_bytes() {
    local bytes="${1:-0}"
    awk -v b="$bytes" 'BEGIN {
        units[1]="B"; units[2]="KB"; units[3]="MB"; units[4]="GB"; units[5]="TB"
        u = 1; val = b + 0
        while (val >= 1024 && u < 5) { val /= 1024; u++ }
        printf "%.1f %s", val, units[u]
    }'
}

# Extract a numeric field from rsync --stats output. $1 is a regex
# matching the start of the line (e.g. 'Total transferred file size:'),
# $2 is the stats text to search. Handles the comma-grouped thousands
# that different rsync versions print.
parse_rsync_stat() {
    local pattern="$1" text="$2"
    printf '%s\n' "$text" | grep -E "^${pattern}" | head -n1 | grep -oE '[0-9,]+' | head -n1 | tr -d ','
}

# Populate the global EXCLUDE_ARGS array from EXCLUDE_FILE, a
# .rccsyncignore file at the root of LOCAL_ROOT (git-style convention,
# always honored if present), and inline EXCLUDE_PATTERNS. Applied to
# push/pull/mirror operations that walk a whole tree (all/dir/mirror);
# NOT applied to push/pull file, since naming a file explicitly should
# always sync it regardless of any pattern. status/diff currently show
# every difference regardless of excludes too — see 'rcc-sync help'.
build_exclude_args() {
    EXCLUDE_ARGS=()

    if [[ -n "$EXCLUDE_FILE" && -f "$EXCLUDE_FILE" ]]; then
        EXCLUDE_ARGS+=(--exclude-from="$EXCLUDE_FILE")
    fi

    if [[ -f "${LOCAL_ROOT}/.rccsyncignore" ]]; then
        EXCLUDE_ARGS+=(--exclude-from="${LOCAL_ROOT}/.rccsyncignore")
    fi

    if [[ -n "$EXCLUDE_PATTERNS" ]]; then
        local pat patterns=()
        IFS=',' read -ra patterns <<< "$EXCLUDE_PATTERNS"
        for pat in "${patterns[@]}"; do
            pat="${pat#"${pat%%[![:space:]]*}"}"
            pat="${pat%"${pat##*[![:space:]]}"}"
            [[ -n "$pat" ]] && EXCLUDE_ARGS+=(--exclude="$pat")
        done
    fi
}

# Whether the large-transfer confirmation should even try to run: not in
# --quiet or --yes mode, at least one threshold enabled, and — crucially
# — only when stdin is an actual terminal, so this can never hang when a
# command is invoked from the TUI's background gauge runner.
should_check_large() {
    [[ $QUIET -eq 1 || $ASSUME_YES -eq 1 ]] && return 1
    [[ "$CONFIRM_FILE_THRESHOLD" -le 0 && "$CONFIRM_SIZE_THRESHOLD_MB" -le 0 ]] && return 1
    [[ -t 0 ]] || return 1
    return 0
}

# Given a file count and byte total, prompt for confirmation if either
# exceeds its configured threshold. Returns 1 if the user declines.
confirm_if_large() {
    local count="$1" bytes="$2" label="$3"
    should_check_large || return 0

    local size_mb=$(( bytes / 1024 / 1024 ))
    local exceeds=0
    [[ "$CONFIRM_FILE_THRESHOLD" -gt 0 && "$count" -ge "$CONFIRM_FILE_THRESHOLD" ]] && exceeds=1
    [[ "$CONFIRM_SIZE_THRESHOLD_MB" -gt 0 && "$size_mb" -ge "$CONFIRM_SIZE_THRESHOLD_MB" ]] && exceeds=1
    [[ $exceeds -eq 0 ]] && return 0

    echo
    log_warn "${label} looks large: ${count} file(s), $(human_bytes "$bytes")."
    local confirm
    read -r -p "Continue? [y/N]: " confirm
    case "$confirm" in
        y|Y|yes|YES) return 0 ;;
        *) echo "Cancelled."; return 1 ;;
    esac
}

# Front door for whole-tree operations (push/pull all|dir, mirror):
# estimate size via an rsync dry run (respecting excludes and any extra
# flags such as --delete) and hand off to confirm_if_large. Any args
# after label/src/dest are passed straight through to the dry-run rsync
# call (e.g. --delete for mirror), so no word-splitting hacks are needed.
confirm_large_rsync() {
    local label="$1" src="$2" dest="$3"
    shift 3
    should_check_large || return 0

    local out f b
    out="$(rsync -an "$@" --stats "${EXCLUDE_ARGS[@]}" "$src" "$dest" 2>/dev/null)"
    f="$(parse_rsync_stat 'Number of (regular files|files) transferred:' "$out")"
    b="$(parse_rsync_stat 'Total transferred file size:' "$out")"
    confirm_if_large "${f:-0}" "${b:-0}" "$label"
}

# Accumulators for the in-progress operation's transfer stats.
_stat_files=0
_stat_bytes=0
_stat_start=0

stats_begin() {
    _stat_files=0
    _stat_bytes=0
    _stat_start="$(date +%s.%N)"
}

# Run rsync with --stats, streaming its normal output as before (unless
# --quiet), and accumulate transferred file/byte counts for the summary
# stats_finish prints. rsync's own -q is deliberately never combined with
# --stats here — testing showed -q suppresses the whole --stats block, so
# --quiet is implemented instead by simply not requesting rsync's -v.
stats_rsync() {
    local tmp rc out
    tmp="$(mktemp)"

    if [[ $QUIET -eq 1 ]]; then
        rsync --stats "$@" > "$tmp" 2>&1
        rc=$?
    else
        rsync --stats "$@" | tee "$tmp"
        rc=${PIPESTATUS[0]}
    fi

    out="$(cat "$tmp")"
    rm -f "$tmp"

    local f b
    f="$(parse_rsync_stat 'Number of (regular files|files) transferred:' "$out")"
    b="$(parse_rsync_stat 'Total transferred file size:' "$out")"
    [[ -n "$f" ]] && _stat_files=$(( _stat_files + f ))
    [[ -n "$b" ]] && _stat_bytes=$(( _stat_bytes + b ))

    return "$rc"
}

# Print the accumulated "Transfer statistics" (unless --quiet) and append
# an entry to the history log either way.
stats_finish() {
    local label="$1"
    local end duration
    end="$(date +%s.%N)"
    duration="$(awk -v s="$_stat_start" -v e="$end" 'BEGIN { printf "%.1f", e - s }')"

    if [[ $QUIET -ne 1 ]]; then
        echo
        echo -e "${C_CYAN}${C_BOLD}Transfer statistics${C_RESET}"
        printf '  Files transferred: %s\n' "$_stat_files"
        printf '  Bytes transferred: %s\n' "$(human_bytes "$_stat_bytes")"
        printf '  Duration: %ss\n' "$duration"
    fi

    log_history "$label" "$_stat_files" "$_stat_bytes" "$duration"
}

log_history() {
    local label="$1" files="$2" bytes="$3" duration="$4"
    mkdir -p "$CONFIG_DIR"
    printf '%s\t%s\tfiles=%s\tbytes=%s\tduration=%ss\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" "$label" "$files" "$bytes" "$duration" >> "$HISTORY_FILE"
}

# Populate LAST_SYNC_LINE with the most recent history entry, if any.
get_last_sync() {
    LAST_SYNC_LINE=""
    [[ -f "$HISTORY_FILE" ]] || return 0
    LAST_SYNC_LINE="$(tail -n1 "$HISTORY_FILE" 2>/dev/null || true)"
}

# ---------------------------------------------------------------------------
# Commands: help / version / config / init
# ---------------------------------------------------------------------------

cmd_help() {
    cat <<'EOF'
RCC Sync

USAGE

  rcc-sync COMMAND

COMMANDS

  help
      Show this help screen

  version
      Show version information

  status
      Show local/remote differences. Add --json for machine-readable output.

  diff
      Show detailed differences (raw diff -rq output)

  push all
      Push local changes to remote

  pull all
      Pull remote changes to local

  dry-push all
      Preview push (no files modified)

  dry-pull all
      Preview pull (no files modified)

  push file <path> [<path> ...]
      Push one or more files. Accepts multiple space-separated paths or
      shell brace expansion: push file dir/{a.txt,b.txt}

  pull file <path> [<path> ...]
      Pull one or more files. Accepts multiple space-separated paths or
      shell brace expansion: pull file dir/{a.txt,b.txt}

  push dir <path>
      Push a single directory

  pull dir <path>
      Pull a single directory

  mirror local
      DESTRUCTIVE: make remote an exact copy of local (rsync --delete).
      Files in remote that are absent from local WILL BE DELETED.
      A compressed snapshot of remote is saved to ARCHIVE_DIR first.

  mirror remote
      DESTRUCTIVE: make local an exact copy of remote (rsync --delete).
      Files in local that are absent from remote WILL BE DELETED.
      A compressed snapshot of local is saved to ARCHIVE_DIR first.

  dry-mirror local
      Preview mirror local->remote without making any changes.

  dry-mirror remote
      Preview mirror remote->local without making any changes.

  restore [name]
      Restore a directory from an ARCHIVE_DIR snapshot. With no name,
      lists available snapshots and prompts for one. Snapshot files are
      overlaid onto their original location (LOCAL_ROOT or REMOTE_ROOT,
      whichever the snapshot was taken from) — anything already there
      that isn't part of the snapshot is left alone. A fresh safety
      snapshot of the current state is taken first automatically.

  history [N|clear]
      Show the last N sync operations (default 20), or clear the log.

  init
      Interactive setup, writes ~/.config/rcc-sync/config

  config
      Show current configuration and the most recent sync

  config validate
      Check the configuration for missing/unwritable directories,
      nested roots, and other common misconfigurations.

  --tui, -t
      Launch interactive menu-driven mode. Uses whiptail/dialog if
      installed and a terminal is attached; otherwise falls back to a
      plain numbered menu.

  --quiet, -q
      Suppress routine output (errors/warnings still show)

  --verbose
      Increase rsync's own verbosity

  --yes, -y
      Skip the "large transfer" confirmation prompt for this run

  --json
      With 'status', print machine-readable JSON instead of text

  Global flags may appear before or after the command, e.g. both
  'rcc-sync push all --quiet' and 'rcc-sync --quiet push all' work. Use
  '--' to stop flag parsing, e.g. 'push file -- --yes' to sync a file
  literally named "--yes".

NOTES

  push/pull never delete files. mirror does delete — use with care.
  A backup snapshot is always created before any mirror operation.
  Snapshots are stored in ARCHIVE_DIR (default: ~/.rcc-sync-archives).
  Set ARCHIVE_DIR=~/<Storage Directory>/RCC-Sync_Archives in config to upload them.
  rcc-sync never runs in the background. It assumes your cloud client
  is already syncing a local directory.

  Pushing/pulling/mirroring a whole tree (all/dir/mirror) honors
  EXCLUDE_FILE, EXCLUDE_PATTERNS, and a .rccsyncignore file at the root
  of LOCAL_ROOT, if configured. 'push file'/'pull file' always sync the
  exact files you name, ignoring excludes. 'status'/'diff' currently
  show every difference regardless of excludes.

  Before an unusually large push/pull/mirror, you'll be asked to
  confirm (see CONFIRM_FILE_THRESHOLD / CONFIRM_SIZE_THRESHOLD_MB in
  config). Pass --yes/-y to skip that prompt for one run.
EOF
}

cmd_version() {
    echo "$VERSION"
}

cmd_config() {
    printf 'LOCAL_ROOT   = %s\n' "$(display_path "$LOCAL_ROOT")"
    printf 'REMOTE_ROOT  = %s\n' "$(display_path "$REMOTE_ROOT")"
    printf 'ARCHIVE_DIR  = %s\n' "$(display_path "$ARCHIVE_DIR")"
    printf 'TUI_THEME    = %s\n' "$TUI_THEME"
    if [[ -n "$CUSTOM_NEWT_COLORS" ]]; then
        printf 'CUSTOM_NEWT_COLORS = %s\n' "$CUSTOM_NEWT_COLORS"
    fi
    if [[ -n "$CUSTOM_ANSI_COLORS" ]]; then
        printf 'CUSTOM_ANSI_COLORS = %s\n' "$CUSTOM_ANSI_COLORS"
    fi
    if [[ -n "$EXCLUDE_FILE" ]]; then
        printf 'EXCLUDE_FILE = %s\n' "$(display_path "$EXCLUDE_FILE")"
    fi
    if [[ -n "$EXCLUDE_PATTERNS" ]]; then
        printf 'EXCLUDE_PATTERNS = %s\n' "$EXCLUDE_PATTERNS"
    fi
    printf 'CONFIRM_FILE_THRESHOLD    = %s\n' "$CONFIRM_FILE_THRESHOLD"
    printf 'CONFIRM_SIZE_THRESHOLD_MB = %s\n' "$CONFIRM_SIZE_THRESHOLD_MB"

    if [[ -f "$CONFIG_FILE" ]]; then
        printf '\n(loaded from %s)\n' "$CONFIG_FILE"
    else
        printf '\n(no config file found, using defaults — run "rcc-sync init" to set one up)\n'
    fi

    get_last_sync
    if [[ -n "$LAST_SYNC_LINE" ]]; then
        local ts label
        ts="$(cut -f1 <<< "$LAST_SYNC_LINE")"
        label="$(cut -f2 <<< "$LAST_SYNC_LINE")"
        printf '\nLast sync: %s — %s\n' "$label" "$ts"
    fi
}

cmd_config_validate() {
    local errors=0 warnings=0

    echo "Validating configuration..."
    echo

    if [[ -z "$LOCAL_ROOT" ]]; then
        log_error "LOCAL_ROOT is not set."
        (( errors++ )) || true
    elif [[ ! -d "$LOCAL_ROOT" ]]; then
        log_warn "LOCAL_ROOT does not exist yet: $(display_path "$LOCAL_ROOT")"
        (( warnings++ )) || true
    else
        echo "  LOCAL_ROOT OK: $(display_path "$LOCAL_ROOT")"
    fi

    if [[ -z "$REMOTE_ROOT" ]]; then
        log_error "REMOTE_ROOT is not set."
        (( errors++ )) || true
    elif [[ ! -d "$REMOTE_ROOT" ]]; then
        log_warn "REMOTE_ROOT does not exist yet: $(display_path "$REMOTE_ROOT")"
        (( warnings++ )) || true
    else
        echo "  REMOTE_ROOT OK: $(display_path "$REMOTE_ROOT")"
    fi

    if [[ -n "$LOCAL_ROOT" && -n "$REMOTE_ROOT" ]]; then
        if [[ "$LOCAL_ROOT" == "$REMOTE_ROOT" ]]; then
            log_error "LOCAL_ROOT and REMOTE_ROOT point to the same path."
            (( errors++ )) || true
        elif [[ "$REMOTE_ROOT" == "$LOCAL_ROOT"/* ]]; then
            log_error "REMOTE_ROOT is nested inside LOCAL_ROOT — this will cause recursive sync issues."
            (( errors++ )) || true
        elif [[ "$LOCAL_ROOT" == "$REMOTE_ROOT"/* ]]; then
            log_error "LOCAL_ROOT is nested inside REMOTE_ROOT — this will cause recursive sync issues."
            (( errors++ )) || true
        fi
    fi

    if [[ -z "$ARCHIVE_DIR" ]]; then
        log_error "ARCHIVE_DIR is not set."
        (( errors++ )) || true
    elif [[ -d "$ARCHIVE_DIR" ]]; then
        if [[ ! -w "$ARCHIVE_DIR" ]]; then
            log_error "ARCHIVE_DIR exists but is not writable: $(display_path "$ARCHIVE_DIR")"
            (( errors++ )) || true
        else
            echo "  ARCHIVE_DIR OK: $(display_path "$ARCHIVE_DIR")"
        fi
    else
        local parent
        parent="$(dirname "$ARCHIVE_DIR")"
        if [[ -d "$parent" && -w "$parent" ]]; then
            echo "  ARCHIVE_DIR will be created on first mirror: $(display_path "$ARCHIVE_DIR")"
        else
            log_warn "ARCHIVE_DIR does not exist and its parent isn't writable: $(display_path "$ARCHIVE_DIR")"
            (( warnings++ )) || true
        fi
    fi

    if [[ -n "$ARCHIVE_DIR" ]]; then
        if [[ -n "$LOCAL_ROOT" && "$ARCHIVE_DIR" == "$LOCAL_ROOT"/* ]]; then
            log_warn "ARCHIVE_DIR is inside LOCAL_ROOT — snapshots will be pushed/mirrored like any other file."
            (( warnings++ )) || true
        fi
        if [[ -n "$REMOTE_ROOT" && "$ARCHIVE_DIR" == "$REMOTE_ROOT"/* ]]; then
            log_warn "ARCHIVE_DIR is inside REMOTE_ROOT — snapshots will be pushed/mirrored like any other file."
            (( warnings++ )) || true
        fi
    fi

    case "$TUI_THEME" in
        default|dark|ocean|matrix|nord|dracula|solarized|gruvbox|custom) : ;;
        *)
            log_warn "Unknown TUI_THEME '${TUI_THEME}' — will fall back to 'default'."
            (( warnings++ )) || true
            ;;
    esac

    if [[ -n "$EXCLUDE_FILE" ]]; then
        if [[ ! -f "$EXCLUDE_FILE" ]]; then
            log_warn "EXCLUDE_FILE is set but does not exist: $(display_path "$EXCLUDE_FILE")"
            (( warnings++ )) || true
        else
            echo "  EXCLUDE_FILE OK: $(display_path "$EXCLUDE_FILE")"
        fi
    fi

    if ! command -v rsync >/dev/null 2>&1; then
        log_error "rsync is not installed or not on PATH."
        (( errors++ )) || true
    fi
    if ! command -v tar >/dev/null 2>&1; then
        log_error "tar is not installed or not on PATH (needed for snapshots/restore)."
        (( errors++ )) || true
    fi

    echo
    if [[ $errors -eq 0 && $warnings -eq 0 ]]; then
        echo -e "${C_GREEN}${C_BOLD}Configuration is valid.${C_RESET}"
        return 0
    elif [[ $errors -eq 0 ]]; then
        echo -e "${C_YELLOW}${C_BOLD}Configuration is valid, with ${warnings} warning(s).${C_RESET}"
        return 0
    else
        echo -e "${C_RED}${C_BOLD}Configuration has ${errors} error(s), ${warnings} warning(s).${C_RESET}"
        return 1
    fi
}

write_config() {
    mkdir -p "$CONFIG_DIR"
    {
        echo "# rcc-sync config"
        echo "LOCAL_ROOT=$(display_path "$LOCAL_ROOT")"
        echo "REMOTE_ROOT=$(display_path "$REMOTE_ROOT")"
        echo "ARCHIVE_DIR=$(display_path "$ARCHIVE_DIR")"
        echo "TUI_THEME=$TUI_THEME"
        if [[ -n "$CUSTOM_NEWT_COLORS" ]]; then
            echo "CUSTOM_NEWT_COLORS=\"$CUSTOM_NEWT_COLORS\""
        fi
        if [[ -n "$CUSTOM_ANSI_COLORS" ]]; then
            echo "CUSTOM_ANSI_COLORS=\"$CUSTOM_ANSI_COLORS\""
        fi
        echo
        echo "# Optional: rsync-style exclude patterns file (one pattern per line,"
        echo "# like .gitignore). A .rccsyncignore file at the root of LOCAL_ROOT is"
        echo "# always honored too, if present. Applies to push/pull/mirror of whole"
        echo "# trees, not to 'push file' / 'pull file' of explicitly named files."
        if [[ -n "$EXCLUDE_FILE" ]]; then
            echo "EXCLUDE_FILE=$(display_path "$EXCLUDE_FILE")"
        else
            echo "EXCLUDE_FILE="
        fi
        echo
        echo "# Optional: comma-separated inline exclude patterns, e.g. *.tmp,node_modules"
        echo "EXCLUDE_PATTERNS=$EXCLUDE_PATTERNS"
        echo
        echo "# Confirmation prompt before unusually large push/pull/mirror runs."
        echo "# Set either to 0 to disable. Bypass a single run with --yes/-y."
        echo "CONFIRM_FILE_THRESHOLD=$CONFIRM_FILE_THRESHOLD"
        echo "CONFIRM_SIZE_THRESHOLD_MB=$CONFIRM_SIZE_THRESHOLD_MB"
    } > "$CONFIG_FILE"
}

cmd_init() {
    echo "RCC Sync setup"
    echo

    local input_local input_remote input_archive input_exclude
    read -r -p "Local directory [$(display_path "$LOCAL_ROOT")]: " input_local
    read -r -p "Remote directory [$(display_path "$REMOTE_ROOT")]: " input_remote
    read -r -p "Archive/snapshot directory [$(display_path "$ARCHIVE_DIR")]: " input_archive
    read -r -p "Exclude patterns file (optional, blank for none) [$(display_path "$EXCLUDE_FILE")]: " input_exclude

    [[ -n "$input_local" ]]   && LOCAL_ROOT="$(expand_path "$input_local")"
    [[ -n "$input_remote" ]]  && REMOTE_ROOT="$(expand_path "$input_remote")"
    [[ -n "$input_archive" ]] && ARCHIVE_DIR="$(expand_path "$input_archive")"
    [[ -n "$input_exclude" ]] && EXCLUDE_FILE="$(expand_path "$input_exclude")"

    write_config
    build_exclude_args

    echo
    echo "Saved to $CONFIG_FILE"
    cmd_config
}

# ---------------------------------------------------------------------------
# Commands: status / diff
# ---------------------------------------------------------------------------

# Shared: run diff -rq between LOCAL_ROOT and REMOTE_ROOT.
# diff exits 0 (identical), 1 (differences found), or 2 (trouble) — none
# of those should be treated as a script failure.
run_diff_rq() {
    diff -rq "$LOCAL_ROOT" "$REMOTE_ROOT" 2>/dev/null
}

cmd_diff() {
    require_dir "$LOCAL_ROOT" "local" || return 1
    require_dir "$REMOTE_ROOT" "remote" || return 1

    local out
    out="$(run_diff_rq)"
    if [[ -z "$out" ]]; then
        echo "No differences."
    else
        printf '%s\n' "$out"
    fi
}

# Populates global arrays STATUS_LOCAL_ONLY / STATUS_REMOTE_ONLY /
# STATUS_DIFFERENT. Shared by cmd_status and cmd_status_json so both
# render from a single computation.
compute_status() {
    STATUS_LOCAL_ONLY=()
    STATUS_REMOTE_ONLY=()
    STATUS_DIFFERENT=()

    local line
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue

        if [[ "$line" == "Only in "* ]]; then
            # Format: "Only in <dir>: <name>"
            local rest dir name rel full
            rest="${line#Only in }"
            dir="${rest%%: *}"
            name="${rest#*: }"

            if [[ "$dir" == "$LOCAL_ROOT"* ]]; then
                rel="${dir#"$LOCAL_ROOT"}"
                rel="${rel#/}"
                [[ -n "$rel" ]] && name="${rel}/${name}"
                full="${LOCAL_ROOT}/${name}"
                if [[ -d "$full" ]]; then
                    while IFS= read -r f; do
                        STATUS_LOCAL_ONLY+=("${name}/${f#"${full}"/}")
                    done < <(find "$full" -type f)
                else
                    STATUS_LOCAL_ONLY+=("$name")
                fi
            elif [[ "$dir" == "$REMOTE_ROOT"* ]]; then
                rel="${dir#"$REMOTE_ROOT"}"
                rel="${rel#/}"
                [[ -n "$rel" ]] && name="${rel}/${name}"
                full="${REMOTE_ROOT}/${name}"
                if [[ -d "$full" ]]; then
                    while IFS= read -r f; do
                        STATUS_REMOTE_ONLY+=("${name}/${f#"${full}"/}")
                    done < <(find "$full" -type f)
                else
                    STATUS_REMOTE_ONLY+=("$name")
                fi
            fi

        elif [[ "$line" == "Files "* ]]; then
            # Format: "Files <a> and <b> differ"
            local rest a
            rest="${line#Files }"
            a="${rest%% and *}"
            if [[ "$a" == "$LOCAL_ROOT"* ]]; then
                local rel="${a#"$LOCAL_ROOT"}"
                rel="${rel#/}"
                STATUS_DIFFERENT+=("$rel")
            fi
        fi
    done < <(run_diff_rq)
}

cmd_status() {
    require_dir "$LOCAL_ROOT" "local" || return 1
    require_dir "$REMOTE_ROOT" "remote" || return 1

    compute_status

    get_last_sync
    if [[ -n "$LAST_SYNC_LINE" ]]; then
        local ts label
        ts="$(cut -f1 <<< "$LAST_SYNC_LINE")"
        label="$(cut -f2 <<< "$LAST_SYNC_LINE")"
        echo "Last sync: ${label} — ${ts}"
        echo
    fi

    if [[ ${#STATUS_LOCAL_ONLY[@]} -eq 0 && ${#STATUS_REMOTE_ONLY[@]} -eq 0 && ${#STATUS_DIFFERENT[@]} -eq 0 ]]; then
        echo "Up to date. No differences between local and remote."
        return 0
    fi

    if [[ ${#STATUS_LOCAL_ONLY[@]} -gt 0 ]]; then
        echo -e "${C_GREEN}${C_BOLD}LOCAL ONLY${C_RESET}: ${#STATUS_LOCAL_ONLY[@]} files"
        echo
        for f in "${STATUS_LOCAL_ONLY[@]}"; do printf '  %s\n' "$f"; done
        echo
    fi

    if [[ ${#STATUS_REMOTE_ONLY[@]} -gt 0 ]]; then
        echo -e "${C_BLUE}${C_BOLD}REMOTE ONLY${C_RESET}: ${#STATUS_REMOTE_ONLY[@]} files"
        echo
        for f in "${STATUS_REMOTE_ONLY[@]}"; do printf '  %s\n' "$f"; done
        echo
    fi

    if [[ ${#STATUS_DIFFERENT[@]} -gt 0 ]]; then
        echo -e "${C_YELLOW}${C_BOLD}DIFFERENT${C_RESET}: ${#STATUS_DIFFERENT[@]} files"
        echo
        for f in "${STATUS_DIFFERENT[@]}"; do printf '  %s\n' "$f"; done
        echo
    fi
}

json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    printf '%s' "$s"
}

json_str_array() {
    local first=1 item
    printf '['
    for item in "$@"; do
        [[ $first -eq 0 ]] && printf ','
        printf '"%s"' "$(json_escape "$item")"
        first=0
    done
    printf ']'
}

cmd_status_json() {
    require_dir "$LOCAL_ROOT" "local" || return 1
    require_dir "$REMOTE_ROOT" "remote" || return 1

    compute_status
    get_last_sync

    local up_to_date="false"
    [[ ${#STATUS_LOCAL_ONLY[@]} -eq 0 && ${#STATUS_REMOTE_ONLY[@]} -eq 0 && ${#STATUS_DIFFERENT[@]} -eq 0 ]] && up_to_date="true"

    printf '{'
    printf '"local_root":"%s",' "$(json_escape "$LOCAL_ROOT")"
    printf '"remote_root":"%s",' "$(json_escape "$REMOTE_ROOT")"
    printf '"up_to_date":%s,' "$up_to_date"
    printf '"local_only":%s,' "$(json_str_array "${STATUS_LOCAL_ONLY[@]}")"
    printf '"remote_only":%s,' "$(json_str_array "${STATUS_REMOTE_ONLY[@]}")"
    printf '"different":%s,' "$(json_str_array "${STATUS_DIFFERENT[@]}")"

    if [[ -n "$LAST_SYNC_LINE" ]]; then
        local ts label files bytes duration
        ts="$(cut -f1 <<< "$LAST_SYNC_LINE")"
        label="$(cut -f2 <<< "$LAST_SYNC_LINE")"
        files="$(cut -f3 <<< "$LAST_SYNC_LINE")"; files="${files#files=}"
        bytes="$(cut -f4 <<< "$LAST_SYNC_LINE")"; bytes="${bytes#bytes=}"
        duration="$(cut -f5 <<< "$LAST_SYNC_LINE")"; duration="${duration#duration=}"; duration="${duration%s}"
        printf '"last_sync":{"timestamp":"%s","operation":"%s","files":%s,"bytes":%s,"duration_seconds":%s}' \
            "$(json_escape "$ts")" "$(json_escape "$label")" "${files:-0}" "${bytes:-0}" "${duration:-0}"
    else
        printf '"last_sync":null'
    fi

    printf '}\n'
}

